{
    "name": "webware/webware-resultset",
    "description": "Result set system for Webware",
    "license": "BSD-3-Clause",
    "keywords": [
        "webware",
        "PhpDb",
        "resultset"
    ],
    "authors": [
        {
            "name": "Joey Smith",
            "email": "jsmith@webinertia.net",
            "role": "Developer"
        }
    ],
    "config": {
        "sort-packages": true
    },
    "require": {
        "php": "~8.3.0 || ~8.4.1 || ~8.5.0"
    },
    "require-dev": {
        "php-db/phpdb": "^0.6.0",
        "phpunit/phpunit": "^11.5.55",
        "roave/security-advisories": "dev-master"
    },
    "autoload": {
        "psr-4": {
            "Webware\\ResultSet\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Webware\\ResultSetTest\\": "test/unit/",
            "Webware\\ResultSetIntegrationTest\\": "test/integration/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "check-all": [
            "@cs-check",
            "@sa",
            "@test"
        ],
        "test": "phpunit --colors=always",
        "test-coverage": "phpunit --colors=always --coverage-clover clover.xml"
    }
}